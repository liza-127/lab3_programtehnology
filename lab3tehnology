namespace lab3tehnology
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("--- Singleton ---");
            AuditLog.GetInstance().Write("Пользователь вошёл");
            AuditLog.GetInstance().Write("Файл открыт");
            Console.WriteLine($"Один экземпляр: {ReferenceEquals(AuditLog.GetInstance(), AuditLog.GetInstance())}");

            Console.WriteLine("\n--- Factory Method ---");
            new CoffeeFactory().Serve();
            new TeaFactory().Serve();

            Console.WriteLine("\n--- Abstract Factory ---");
            IFurnitureFactory f = new WoodFactory();
            f.CreateChair().Sit();
            f.CreateTable().Put();

            f = new MetalFactory();
            f.CreateChair().Sit();
            f.CreateTable().Put();

            Console.WriteLine("\n--- Builder ---");
            var builder = new ChickenSandwichBuilder();
            new SandwichDirector(builder).Make();
            Console.WriteLine(builder.GetResult());
        }
    }
}

// SINGLETON 
//  (приватное поле + приватный конструктор + getInstance),
class AuditLog
{
    private static AuditLog? _instance;

    private AuditLog() { }

    public static AuditLog GetInstance()
    {
        if (_instance == null)
            _instance = new AuditLog();
        return _instance;
    }

    public void Write(string msg) => Console.WriteLine($"[AUDIT] {msg}");
}


// FACTORY METHOD
//  (интерфейс и абстрактная фабрика и фабричный метод),

interface IDrink { void Pour(); }

class Coffee : IDrink 
{
    public void Pour() => Console.WriteLine("Наливаю кофе"); 
}
class Tea : IDrink
{
    public void Pour() => Console.WriteLine("Наливаю чай");
}

abstract class DrinkFactory
{
    public abstract IDrink CreateDrink();       // фабричный метод

    public void Serve()                          // общая логика
    {
        IDrink drink = CreateDrink();
        drink.Pour();
    }
}

class CoffeeFactory : DrinkFactory 
{
    public override IDrink CreateDrink() => new Coffee();
}
class TeaFactory : DrinkFactory
{
    public override IDrink CreateDrink() => new Tea();
}


// ABSTRACT FACTORY 
//интерфейсы продуктов и   интерфейс фабрики
interface IChair { void Sit(); }
interface ITable { void Put(); }

class WoodChair : IChair 
{
    public void Sit() => Console.WriteLine("Деревянный стул"); 
}
class WoodTable : ITable
{
    public void Put() => Console.WriteLine("Деревянный стол"); 
}
class MetalChair : IChair 
{
    public void Sit() => Console.WriteLine("Металлический стул"); 
}
class MetalTable : ITable 
{
    public void Put() => Console.WriteLine("Металлический стол"); 
}

interface IFurnitureFactory
{
    IChair CreateChair();
    ITable CreateTable();
}

class WoodFactory : IFurnitureFactory
{
    public IChair CreateChair() => new WoodChair();
    public ITable CreateTable() => new WoodTable();
}

class MetalFactory : IFurnitureFactory
{
    public IChair CreateChair() => new MetalChair();
    public ITable CreateTable() => new MetalTable();
}


// BUILDER 
// интерфейс строителя и конкретный строитель и  директор
class Sandwich
{
    public string Bread { get; set; } = "";
    public string Meat { get; set; } = "";
    public string Salad { get; set; } = "";

    public override string ToString() =>
        $"Сэндвич: хлеб={Bread}, мясо={Meat}, салат={Salad}";
}

interface ISandwichBuilder
{
    void BuildBread();
    void BuildMeat();
    void BuildSalad();
    Sandwich GetResult();
}

class ChickenSandwichBuilder : ISandwichBuilder
{
    private readonly Sandwich _sandwich = new();
    public void BuildBread() => _sandwich.Bread = "багет";
    public void BuildMeat() => _sandwich.Meat = "курица";
    public void BuildSalad() => _sandwich.Salad = "айсберг";
    public Sandwich GetResult() => _sandwich;
}

class SandwichDirector
{
    private readonly ISandwichBuilder _builder;
    public SandwichDirector(ISandwichBuilder b) => _builder = b;

    public void Make()
    {
        _builder.BuildBread();
        _builder.BuildMeat();
        _builder.BuildSalad();
    }
}



